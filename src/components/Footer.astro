---
// src/components/Footer.astro
import { site } from '../config.js';

const isDev = import.meta.env.DEV;
const fssai = site.fssai;
const fssaiDisplay = fssai && /^\d{14}$/.test(fssai) ? fssai : null;
const year = new Date().getFullYear();

const quickLinks = [
  { href: '/',                  label: 'Home' },
  { href: '/products',          label: 'Products' },
  { href: '/about',             label: 'Our Story' },
  { href: '/bulk',              label: 'Bulk Orders' },
  { href: '/contact',           label: 'Contact' },
  { href: '/privacy',           label: 'Privacy Policy' },
  { href: '/shipping-returns',  label: 'Shipping & Returns' },
];
---

<footer class="bg-green-dark text-cream/90">
  <!-- Gold top border -->
  <div class="h-0.5 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand col -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4" aria-label="Tea Reserve home">
          <img
            src="/assets/logo.jpeg"
            alt="Tea Reserve logo"
            width="56"
            height="56"
            class="w-14 h-14 rounded-xl object-cover border-2 border-gold/40"
            loading="lazy"
          />
          <div>
            <span class="block font-serif font-bold text-cream text-xl">{site.name}</span>
            <span class="block text-gold-light text-xs tracking-widest uppercase mt-0.5">{site.tagline}</span>
          </div>
        </a>
        <p class="text-sm text-cream/70 leading-relaxed max-w-xs">
          Pure CTC tea sourced from Assam gardens. Rich aroma, strong taste — your perfect everyday chai.
        </p>
        <!-- Gold divider -->
        <div class="gold-divider gold-divider-left mt-6 mb-0 opacity-50"></div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-serif font-semibold text-cream text-lg mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-cream/70 hover:text-gold-light transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-serif font-semibold text-cream text-lg mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm text-cream/70">
          <li class="flex gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{site.address}</span>
          </li>
          <li class="flex gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div class="flex flex-col gap-1">
              <a href={`tel:${site.phone1}`} class="hover:text-gold-light transition-colors">{site.phone1}</a>
              <a href={`tel:${site.phone2}`} class="hover:text-gold-light transition-colors">{site.phone2}</a>
            </div>
          </li>
          <li class="flex gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={`mailto:${site.email}`} class="hover:text-gold-light transition-colors break-all">{site.email}</a>
          </li>
        </ul>
      </div>

      <!-- WhatsApp CTA -->
      <div>
        <h3 class="font-serif font-semibold text-cream text-lg mb-4">Order Now</h3>
        <p class="text-sm text-cream/70 mb-4">Reach us directly on WhatsApp for orders and enquiries.</p>
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I\'d like to order Tea Reserve CTC Tea.')}`}
          class="btn-whatsapp text-sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Order on WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp Us
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-cream/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-cream/50">
      <span>© {year} {site.name}. All rights reserved.</span>

      <!-- FSSAI line -->
      {fssaiDisplay ? (
        <span>FSSAI Lic. No.: {fssaiDisplay}</span>
      ) : isDev ? (
        <span class="bg-yellow-400 text-yellow-900 px-2 py-0.5 rounded font-mono font-bold">
          FSSAI Lic. No.: ______ (add in src/config.js)
        </span>
      ) : null}

      <span>Marketed &amp; Packed by {site.name}, {site.address}</span>
    </div>
  </div>
</footer>
