---
// src/components/Header.astro
import { site } from '../config.js';

const navLinks = [
  { href: '/',           label: 'Home' },
  { href: '/products',   label: 'Products' },
  { href: '/about',      label: 'Our Story' },
  { href: '/bulk',       label: 'Bulk Orders' },
  { href: '/contact',    label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const waLink = `https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I\'d like to know more about Tea Reserve CTC Tea.')}`;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-green/10"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Tea Reserve — Home">
        <img
          src="/assets/logo.jpeg"
          alt="Tea Reserve logo"
          width="48"
          height="48"
          class="w-10 h-10 lg:w-12 lg:h-12 rounded-lg object-cover"
          loading="eager"
        />
        <div class="hidden sm:block">
          <span class="block font-serif font-bold text-green text-lg leading-tight">{site.name}</span>
          <span class="block text-gold text-[10px] tracking-widest uppercase">{site.tagline}</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'text-green bg-cream font-semibold'
                  : 'text-ink hover:text-green hover:bg-cream/80'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop WhatsApp CTA -->
      <a
        href={waLink}
        class="hidden lg:inline-flex btn-whatsapp text-sm"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Order via WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Order on WhatsApp
      </a>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="lg:hidden p-2 rounded-lg text-green hover:bg-cream transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <span class="sr-only">Menu</span>
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" role="navigation" aria-label="Mobile navigation">
      <nav class="pb-4 flex flex-col gap-1">
        {navLinks.map(link => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`px-4 py-3 rounded-lg font-medium transition-colors ${
                isActive
                  ? 'text-green bg-cream font-semibold'
                  : 'text-ink hover:text-green hover:bg-cream/60'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
        <a
          href={waLink}
          class="btn-whatsapp mt-2 justify-center text-sm"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Order via WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Order on WhatsApp
        </a>
      </nav>
    </div>
  </div>
</header>

<!-- Spacer so content doesn't go under fixed header -->
<div class="h-16 lg:h-20" aria-hidden="true"></div>
