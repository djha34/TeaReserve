---
// src/components/ProductCard.astro
// Used on Products listing page and as featured card on Home

interface Product {
  id: string;
  name: string;
  slug: string;
  weight: string;
  price: number;
  priceNote: string;
  description: string;
  image: string;
  imageAlt: string;
  features: string[];
  whatsappMessage: string;
}

interface Props {
  product: Product;
  featured?: boolean;
  waNumber: string;
}

const { product, featured = false, waNumber } = Astro.props;
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(product.whatsappMessage)}`;
---

<article
  class={`product-card bg-white rounded-2xl border-2 border-transparent overflow-hidden ${featured ? 'shadow-xl' : 'shadow-md'}`}
  aria-label={product.name}
>
  <!-- Image -->
  <a href={`/products/${product.slug}`} class="block overflow-hidden aspect-[4/3] bg-cream" aria-label={`View ${product.name}`}>
    <img
      src={product.image}
      alt={product.imageAlt}
      width="800"
      height="600"
      class="product-card-img w-full h-full object-contain p-4"
      loading="lazy"
    />
  </a>

  <!-- Body -->
  <div class="p-6">
    <!-- Badge -->
    <span class="inline-block bg-cream text-green text-xs font-semibold tracking-wide px-3 py-1 rounded-full mb-3">
      Pure CTC Tea
    </span>

    <h3 class="font-serif text-xl text-green mb-1">
      <a href={`/products/${product.slug}`} class="hover:text-gold transition-colors">
        {product.name}
      </a>
    </h3>

    <p class="text-sm text-ink/60 mb-3">{product.weight}</p>
    <p class="text-sm text-ink/70 leading-relaxed mb-4 line-clamp-2">{product.description}</p>

    <!-- Features (first 3) -->
    <ul class="space-y-1 mb-5">
      {product.features.slice(0, 3).map(f => (
        <li class="flex items-center gap-2 text-sm text-ink/70">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {f}
        </li>
      ))}
    </ul>

    <!-- Price & CTA -->
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <span class="text-2xl font-bold font-serif text-green">₹{product.price}</span>
        <span class="text-xs text-ink/50 block">{product.priceNote}</span>
      </div>
      <div class="flex gap-2 flex-wrap">
        <a href={`/products/${product.slug}`} class="btn-secondary text-sm py-2 px-4">
          Details
        </a>
        <a href={waLink} class="btn-whatsapp text-sm py-2 px-4" target="_blank" rel="noopener noreferrer" aria-label={`Order ${product.name} on WhatsApp`}>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Order
        </a>
      </div>
    </div>
  </div>
</article>
