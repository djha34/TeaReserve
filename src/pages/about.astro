---
// src/pages/about.astro — Our Story page
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../config.js';

const values = [
  { icon: '🌿', title: 'Quality', desc: 'We source CTC tea from Assam\'s established tea gardens and pack it under hygienic conditions to ensure consistency in every batch.' },
  { icon: '🔄', title: 'Consistency', desc: 'Every pack of Tea Reserve tea brews the same rich, strong cup — whether it\'s your first pack or your fiftieth.' },
  { icon: '💚', title: 'Fair Price', desc: 'Our MRP is inclusive of all taxes. We believe great tea should be affordable — ₹420 for 1 kg, no hidden charges.' },
];

const timeline = [
  { step: 'Garden', desc: 'CTC tea leaves are hand-selected and processed in Assam\'s tea estates — India\'s most celebrated tea region.' },
  { step: 'Blend', desc: 'The tea granules are carefully blended for a consistent flavour profile — bold, aromatic, and full-bodied.' },
  { step: 'Pack', desc: 'Packed hygienically in Mumbai with the batch number and date printed on every pack for full traceability.' },
  { step: 'Your Cup', desc: 'From our pack to your kettle — a strong, flavourful chai, ready in minutes.' },
];
---

<BaseLayout
  title="Our Story"
  description="The Tea Reserve story — pure CTC tea from Assam gardens to your table. Quality, consistency, and fair pricing from Mumbai."
>
  <!-- Hero banner -->
  <section class="bg-green-dark py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none" aria-hidden="true">
      <svg class="w-full h-full" viewBox="0 0 800 400" fill="none">
        <circle cx="700" cy="50" r="200" stroke="#b8902f" stroke-width="1" fill="none"/>
        <circle cx="100" cy="350" r="150" stroke="#b8902f" stroke-width="0.5" fill="none"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb crumbs={[{ href: '/', label: 'Home' }, { label: 'Our Story' }]} />
      <div class="mt-6 max-w-2xl">
        <SectionTitle
          title="Our Story"
          subtitle="How a love for great chai became Tea Reserve — from Assam's gardens to Mumbai's tables."
          tag="About Us"
          light
        />
      </div>
    </div>
  </section>

  <!-- Story section -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div class="reveal-left">
          <img
            src="/assets/logo.jpeg"
            alt="Tea Reserve brand — classic teapot emblem"
            width="500"
            height="500"
            class="rounded-3xl shadow-xl border-2 border-gold/20 w-full max-w-sm mx-auto"
            loading="lazy"
          />
        </div>
        <div class="reveal-right">
          <SectionTitle title="From Garden to Cup" tag="The Journey" />
          <div class="space-y-4 mt-4 text-ink/70 leading-relaxed">
            <p>
              Tea Reserve was born from a simple belief: every household deserves access to quality CTC tea — the kind that brews a rich, robust cup of chai without any compromise.
            </p>
            <p>
              We source our tea from the gardens of Assam, India's most celebrated tea-growing region, known for its distinctive bold character and naturally malty notes. The CTC (Crush, Tear, Curl) process creates dense, uniform granules that brew quickly and deliver consistent flavour — perfect for the daily chai that millions of Indian families rely on.
            </p>
            <p>
              Packed in Mumbai and marketed under the Tea Reserve brand, every pack carries the packing date and batch number — because we believe transparency builds trust. The MRP of ₹420 for 1 kg is inclusive of all taxes, with no hidden surprises.
            </p>
            <p>
              Whether you're brewing for yourself, your family, or your business — Tea Reserve is committed to delivering the same quality every single time.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section-padding bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <SectionTitle title="Our Values" subtitle="What drives everything we do." tag="Our Principles" center />
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {values.map((v, i) => (
          <div class={`reveal delay-${(i+1)*100} bg-white rounded-2xl p-8 shadow-sm border border-gold/10 text-center hover:shadow-md hover:border-gold/30 transition-all`}>
            <div class="text-5xl mb-4" role="img" aria-label={v.title}>{v.icon}</div>
            <h3 class="font-serif text-green text-xl mb-3">{v.title}</h3>
            <p class="text-ink/60 text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process timeline -->
  <section class="section-padding bg-green">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 reveal">
        <SectionTitle title="Garden to Your Cup" subtitle="Our process in four simple steps." tag="The Process" center light />
      </div>
      <div class="relative">
        <!-- Connecting line on desktop -->
        <div class="hidden lg:block absolute top-8 left-0 right-0 h-0.5 bg-gold/30" aria-hidden="true"></div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {timeline.map((t, i) => (
            <div class={`reveal delay-${(i+1)*100} relative text-center`}>
              <!-- Step number circle -->
              <div class="w-16 h-16 rounded-full bg-gold flex items-center justify-center font-serif font-bold text-white text-xl mx-auto mb-4 shadow-lg relative z-10">
                {i + 1}
              </div>
              <h3 class="font-serif text-cream text-lg mb-2">{t.step}</h3>
              <p class="text-cream/60 text-sm leading-relaxed">{t.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="bg-cream py-16 px-4 text-center">
    <div class="max-w-xl mx-auto reveal">
      <img src="/assets/logo.jpeg" alt="Tea Reserve" width="80" height="80" class="w-16 h-16 rounded-2xl mx-auto mb-4 border border-gold/30" loading="lazy" />
      <h2 class="font-serif text-green text-2xl sm:text-3xl mb-3">Get in Touch</h2>
      <p class="text-ink/60 mb-6">Have questions about our tea, or want to place an order? We're just a WhatsApp message away.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I\'d like to know more about Tea Reserve.')}`} class="btn-whatsapp justify-center" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
        <a href="/contact" class="btn-secondary justify-center">Contact Details</a>
      </div>
    </div>
  </section>
</BaseLayout>
