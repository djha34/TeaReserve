---
// src/pages/404.astro — Custom 404 page
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config.js';
---

<BaseLayout
  title="Page Not Found"
  description="Oops! This page doesn't exist. Return to Tea Reserve home."
  noIndex={true}
>
  <section class="min-h-[70vh] flex flex-col items-center justify-center bg-cream px-4 py-20 text-center">
    <!-- Logo / teapot illustration -->
    <div class="mb-6">
      <img
        src="/assets/logo.jpeg"
        alt="Tea Reserve teapot logo"
        width="120"
        height="120"
        class="w-24 h-24 sm:w-32 sm:h-32 rounded-2xl mx-auto border-2 border-gold/30 shadow-lg"
        loading="eager"
      />
    </div>

    <!-- Error code with steam -->
    <div class="relative mb-2" aria-hidden="true">
      <svg viewBox="0 0 160 60" class="w-40 mx-auto mb-0" fill="none">
        <path class="steam-path" d="M40 55 Q42 35 36 15 Q33 2 40 0" stroke="#b8902f" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        <path class="steam-path" d="M80 55 Q82 30 76 12 Q73 1 80 0" stroke="#b8902f" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
        <path class="steam-path" d="M120 55 Q122 35 116 15 Q113 2 120 0" stroke="#b8902f" stroke-width="2" stroke-linecap="round" opacity="0.5"/>
      </svg>
    </div>

    <h1 class="font-serif text-green text-6xl sm:text-8xl font-bold mb-3">404</h1>
    <div class="gold-divider mx-auto mb-4"></div>
    <h2 class="font-serif text-green text-2xl sm:text-3xl mb-3">Page Not Found</h2>
    <p class="text-ink/60 text-lg mb-8 max-w-md">
      Looks like this page wandered off to the tea gardens. Let's get you back to the good stuff.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="btn-primary px-8 py-3">🏠 Go Home</a>
      <a href="/products" class="btn-secondary px-8 py-3">View Our Tea</a>
    </div>

    <p class="text-ink/40 text-sm mt-8">
      Need help? <a href={`https://wa.me/${site.whatsappNumber}`} class="text-green underline hover:text-gold" target="_blank" rel="noopener noreferrer">WhatsApp us</a>
    </p>
  </section>
</BaseLayout>
