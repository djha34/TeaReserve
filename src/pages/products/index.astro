---
// src/pages/products/index.astro — Products listing page
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { site } from '../../config.js';
import products from '../../data/products.json';

const moreComing = products.length === 1;
---

<BaseLayout
  title="Our Products"
  description="Tea Reserve CTC Tea — 1 kg pure CTC tea from Assam at MRP ₹420 (incl. all taxes). Rich aroma, strong taste. Order on WhatsApp."
>
  <!-- Page header -->
  <section class="bg-green-dark py-16 px-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb crumbs={[{ href: '/', label: 'Home' }, { label: 'Products' }]} />
      <div class="mt-4">
        <SectionTitle
          title="Our Products"
          subtitle="Pure CTC tea from Assam — crafted for the perfect cup of chai."
          tag="What We Offer"
          light
        />
      </div>
    </div>
  </section>

  <!-- Products grid -->
  <section class="section-padding bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product, i) => (
          <div class={`reveal delay-${(i % 3 + 1) * 100}`}>
            <ProductCard product={product} waNumber={site.whatsappNumber} />
          </div>
        ))}
      </div>

      {moreComing && (
        <div class="mt-12 text-center reveal">
          <div class="inline-block bg-white border-2 border-dashed border-gold/40 rounded-2xl px-8 py-6">
            <p class="text-ink/50 text-lg font-serif">🍃 More variants coming soon</p>
            <p class="text-ink/40 text-sm mt-1">Follow us or drop a WhatsApp message to stay updated.</p>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Bulk orders CTA -->
  <section class="bg-green py-14 px-4 text-center">
    <div class="max-w-2xl mx-auto reveal">
      <h2 class="font-serif text-cream text-2xl sm:text-3xl mb-3">Need Larger Quantities?</h2>
      <p class="text-cream/70 mb-6">Bulk supply for tea stalls, hotels, and offices. Get a WhatsApp quote in minutes.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I need a bulk quote for Tea Reserve CTC Tea.')}`}
          class="btn-whatsapp justify-center"
          target="_blank" rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Get Bulk Quote
        </a>
        <a href="/bulk" class="btn-secondary border-cream/40 text-cream hover:bg-cream hover:text-green justify-center">
          See Bulk Details
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
