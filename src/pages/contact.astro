---
// src/pages/contact.astro — Contact page
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../config.js';

const isDev = import.meta.env.DEV;

const contactCards = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Address',
    content: site.address,
    link: null,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
    title: 'Phone',
    content: `${site.phone1} / ${site.phone2}`,
    link: `tel:${site.phone1}`,
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: 'Email',
    content: site.email,
    link: `mailto:${site.email}`,
  },
];
---

<BaseLayout
  title="Contact"
  description="Contact Tea Reserve — address in Virar, Palghar. Call or WhatsApp: 7770094574 / 7395092161. Email: teareservemumbai@gmail.com."
>
  <!-- Page hero -->
  <section class="bg-green-dark py-16 px-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]} />
      <div class="mt-6">
        <SectionTitle
          title="Get in Touch"
          subtitle="We'd love to hear from you. Reach out for orders, bulk enquiries, or any questions."
          tag="Contact Us"
          light
        />
      </div>
    </div>
  </section>

  <!-- Contact cards + map -->
  <section class="section-padding bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-6 mb-12">
        {contactCards.map((card, i) => (
          <div class={`reveal delay-${(i+1)*100} bg-white rounded-2xl p-6 shadow-sm border border-gold/10 hover:shadow-md hover:border-gold/30 transition-all`}>
            <div class="w-14 h-14 rounded-xl bg-cream flex items-center justify-center text-green mb-4" set:html={card.icon} aria-hidden="true"></div>
            <h3 class="font-serif text-green text-lg mb-2">{card.title}</h3>
            {card.link ? (
              <a href={card.link} class="text-ink/70 hover:text-green transition-colors text-sm break-all">
                {card.content}
              </a>
            ) : (
              <p class="text-ink/70 text-sm">{card.content}</p>
            )}
          </div>
        ))}
      </div>

      <!-- WhatsApp card (prominent) -->
      <div class="reveal bg-whatsapp/10 border-2 border-whatsapp/30 rounded-2xl p-6 sm:p-8 text-center mb-12">
        <h3 class="font-serif text-green text-xl mb-2">Fastest Way to Reach Us</h3>
        <p class="text-ink/60 mb-4">Send us a WhatsApp message and we'll respond as quickly as possible.</p>
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I have a query about Tea Reserve.')}`}
          class="btn-whatsapp mx-auto inline-flex text-base px-8 py-4"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Message Tea Reserve on WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Message on WhatsApp: +{site.whatsappNumber}
        </a>
      </div>

      <!-- Business hours placeholder — hidden in production if not set -->
      {isDev && (
        <div class="reveal bg-yellow-50 border-2 border-dashed border-yellow-300 rounded-xl p-4 mb-8 text-center">
          <p class="text-yellow-800 text-sm font-semibold">📌 Business Hours Placeholder (fill in or remove before deploy)</p>
          <p class="text-yellow-700 text-xs mt-1">e.g. Mon–Sat: 9 AM – 7 PM | Sunday: 10 AM – 2 PM</p>
        </div>
      )}

      <!-- Google Map (lazy loaded iframe) -->
      <div class="reveal rounded-2xl overflow-hidden shadow-lg border border-gold/20">
        <iframe
          src={site.mapEmbedUrl}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Tea Reserve location — Virar, Palghar, Maharashtra"
          class="w-full"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
