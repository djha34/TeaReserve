---
// src/pages/shipping-returns.astro — Shipping & Returns Policy
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../config.js';
---

<BaseLayout
  title="Shipping & Returns"
  description="Shipping and returns policy for Tea Reserve. Contact us via WhatsApp for order queries."
  noIndex={true}
>
  <section class="bg-green-dark py-12 px-4">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <Breadcrumb crumbs={[{ href: '/', label: 'Home' }, { label: 'Shipping & Returns' }]} />
      <h1 class="font-serif text-cream mt-4">Shipping &amp; Returns Policy</h1>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <!-- OWNER: Fill in the details below before deploying. -->
      <div class="bg-yellow-50 border-2 border-dashed border-yellow-300 rounded-xl p-4 mb-8">
        <p class="text-yellow-800 text-sm font-semibold">📌 Owner Action Required: Fill in this Shipping & Returns policy before deploying.</p>
        <p class="text-yellow-700 text-xs mt-1">Replace placeholders with your actual policies. Consult a legal/business advisor if needed.</p>
      </div>

      <p class="text-ink/50 text-sm mb-8">Last updated: [ADD DATE]</p>

      <div class="space-y-8 text-ink/70 leading-relaxed">
        <div>
          <h2 class="font-serif text-green text-xl mb-3">How to Order</h2>
          <p>
            Tea Reserve currently accepts orders via WhatsApp only. Click any "Order on WhatsApp" button on this website to start a chat. Our team will confirm availability, pricing, and delivery details.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Delivery Areas</h2>
          <p>
            [OWNER: List the areas you deliver to. Example: "We currently deliver within Mumbai, Virar, Vasai, and surrounding Palghar district areas."]
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Delivery Time</h2>
          <p>
            [OWNER: Add your typical delivery time. Example: "Orders placed before 12 PM are typically delivered within 1–2 business days within the delivery area."]
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Delivery Charges</h2>
          <p>
            [OWNER: Specify delivery charges or free delivery threshold. Example: "Delivery is free for orders above ₹500. A delivery charge of ₹50 applies for smaller orders."]
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Returns & Refunds</h2>
          <p>
            [OWNER: Describe your return/refund policy. Example: "We accept returns only for damaged or incorrectly delivered products. Please send a WhatsApp message with a photo of the issue within 24 hours of receiving the order."]
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Product Quality</h2>
          <p>
            Every pack of Tea Reserve CTC tea has the packing date and batch number printed on it. If you have any concerns about the quality of a batch, please contact us via WhatsApp with the batch details.
          </p>
        </div>

        <div>
          <h2 class="font-serif text-green text-xl mb-3">Contact for Order Queries</h2>
          <div class="flex flex-col sm:flex-row gap-4 mt-4">
            <a
              href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hi! I have a query about my Tea Reserve order.')}`}
              class="btn-whatsapp text-sm justify-center"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp Us
            </a>
            <a href={`mailto:${site.email}`} class="btn-secondary text-sm justify-center">
              Email: {site.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
